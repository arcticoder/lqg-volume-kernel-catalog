{"task":"Validate Diophantine spin‐kernel solutions for four‐valent volume operator","priority":"High","python_snippet":"from project.volume_operator import solve_diophantine_kernel\n# sample spin tuples\ntests = [(1,1,1,1),(2,2,2,2),(1,2,3,2)]\nfor spins in tests:\n    sols = solve_diophantine_kernel(*spins)\n    assert all(isinstance(sol, tuple) for sol in sols), f\"Invalid solutions for {spins}\""}
{"task":"Numeric validation of volume operator kernel vs direct matrix element computation","priority":"High","depends_on":"C:\\Users\\%USERNAME%\\Code\\asciimath\\su2-node-matrix-elements\\VnV-TODO.ndson","python_snippet":"import sympy as sp\nfrom project.volume_operator import kernel_eigenvalues\nfrom project.su2_matrix_elements import closed_form_matrix_element\n# compare kernel labels to explicit matrix elements for small spins\ntests = [(1,1,1,1),(2,2,2,2)]\nfor spins in tests:\n    ker = kernel_eigenvalues(*spins)\n    # reconstruct by diagonalizing the matrix\n    matrix = sp.Matrix([[closed_form_matrix_element(*(spins+(m,))) for m in ker] for _ in ker])\n    assert sorted(ker)==sorted([ev.evalf() for ev in matrix.eigenvals().keys()])"}
{"task":"Regression test for volume operator kernel catalog against reference data","priority":"Medium","python_snippet":"import json\nfrom project.volume_operator import kernel_eigenvalues\nwith open('tests/reference_volume_kernel.json') as f:\n    ref = json.load(f)\nfor key,val in ref.items():\n    spins = tuple(map(int,key.split(',')))\n    assert kernel_eigenvalues(*spins)==val, f\"Ref mismatch for {spins}\""}
{"task":"Symmetry checks for kernel under spin permutation","priority":"Medium","depends_on":"C:\\Users\\%USERNAME%\\Code\\asciimath\\su2-node-matrix-elements\\VnV-TODO.ndson","python_snippet":"import sympy as sp\nfrom project.volume_operator import kernel_eigenvalues\nspins = (1,2,3,2)\na = kernel_eigenvalues(*spins)\nb = kernel_eigenvalues(spins[1],spins[0],spins[2],spins[3])\nassert a==b, \"Permutation symmetry violated\""}
{"task":"Domain validation for diophantine solver parameters","priority":"Low","python_snippet":"from project.volume_operator import solve_diophantine_kernel\n# test integer and half-integer spins up to 1\ncases = [(i/2,j/2,k/2,l/2) for i in (0,1,2) for j in (0,1,2) for k in (0,1,2) for l in (0,1,2)]\nfor c in cases:\n    try:\n        solve_diophantine_kernel(*c)\n    except Exception as e:\n        assert False, f\"Domain error for {c}: {e}\""}
{"task":"Performance benchmark of diophantine solver vs brute-force search","priority":"Medium","python_snippet":"import time\nfrom project.volume_operator import solve_diophantine_kernel, brute_force_kernel\nspins = (5,5,5,5)\nt0 = time.time(); brute_force_kernel(*spins); t1 = time.time()-t0\nt0 = time.time(); solve_diophantine_kernel(*spins); t2 = time.time()-t0\nassert t2 < t1, f\"Solver slower ({t2:.4f}s) vs brute ({t1:.4f}s)\""}
{"task":"Cross-check kernel composition via 3nj recurrences","priority":"Medium","depends_on":"C:\\Users\\%USERNAME%\\Code\\asciimath\\su2-3nj-recurrences\\VnV-TODO.ndson","python_snippet":"import sympy as sp\nfrom project.volume_operator import kernel_eigenvalues\nfrom project.su2_3nj_recurrences import recursion_3nj\n# check that kernel entries match sums over intermediate recurrences\nspins=(1,1,1,1)\nkern = kernel_eigenvalues(*spins)\nsum_rec = sum(recursion_3nj(spins[0],spins[1],spins[2],spins[3],m,n) for m in kern for n in kern)\nassert isinstance(sum_rec, (int, sp.Expr)), \"Recurrence composition failed\""}
{"task":"Special-case consistency with closed-form hypergeometric representation","priority":"Medium","depends_on":"C:\\Users\\%USERNAME%\\Code\\asciimath\\su2-3nj-closedform\\VnV-TODO.ndson","python_snippet":"import sympy as sp\nfrom project.volume_operator import kernel_eigenvalues\nfrom project.su2_3nj_closed_form import closed_form_3nj\n# for 3-valent reduction, kernel matches 6j symbol\nspins=(1,1,1,0)\nk = kernel_eigenvalues(*spins)\njv = closed_form_3nj(1,1,1,1,1,1)\nassert k[0]==jv, \"Hypergeometric closed-form mismatch\""}
